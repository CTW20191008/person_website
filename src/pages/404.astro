---
import { resolveRoute } from "../present/render-site.js";
import { loadPublishedSite, siteOrigin } from "../present/site.js";

const route = resolveRoute(loadPublishedSite(), "/missing", { siteUrl: siteOrigin });
if (route.status !== 404) {
  throw new Error("404 页面没有生成");
}
return new Response(route.body, {
  status: 404,
  headers: { "Content-Type": route.contentType },
});
---
